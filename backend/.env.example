# Copy to backend/.env for local development. Never commit the real .env.

# PostgreSQL connection string (Neon, Render Postgres, or a local database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

PORT=8080

# Website address(es) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Apply pending database migrations every time the API starts.
MIGRATE_ON_START=true

# Contact form email (https://resend.com). Without a key, messages are only
# saved to the database.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nkokomoukan@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
