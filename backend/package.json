{
  "name": "@portfolio/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "media:upload": "tsx --env-file-if-exists=.env scripts/upload-media.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@portfolio/database": "workspace:*",
    "@portfolio/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "cloudinary": "^2.7.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.21.0"
  }
}
