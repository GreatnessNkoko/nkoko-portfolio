# Public, non-secret build settings (safe to commit). Override them in
# Vercel > Project > Settings > Environment Variables if they change.

# The site's public address, used for SEO and link previews.
VITE_SITE_URL=https://nkokoportfolio.vercel.app

# Cloudinary cloud name. Leave empty to serve images and the CV from
# frontend/public/media instead. Run `pnpm media:upload` before setting it.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FOLDER=portfolio
