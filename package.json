{
  "name": "nkoko-portfolio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @portfolio/frontend run dev",
    "dev:backend": "pnpm --filter @portfolio/backend run dev",
    "build": "pnpm -r --if-present run build",
    "build:frontend": "pnpm --filter @portfolio/frontend run build",
    "build:backend": "pnpm --filter @portfolio/backend run build",
    "start:backend": "pnpm --filter @portfolio/backend run start",
    "db:generate": "pnpm --filter @portfolio/database run generate",
    "db:migrate": "pnpm --filter @portfolio/database run migrate",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
